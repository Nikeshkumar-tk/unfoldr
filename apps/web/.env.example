# Copy this file to .env.local and fill in real values.
# These come from `cdk deploy` output of apps/infra. Look for:
#   - UnfoldrStack-...Cognito.UserPoolId
#   - UnfoldrStack-...Cognito.UserPoolClientId
#   - UnfoldrStack-...HttpApi.HttpApiUrl

# Brand shown in <title> and on auth pages
VITE_ORG_NAME=Acme

# Cognito (from cdk deploy outputs)
VITE_USER_POOL_ID=us-east-1_dmRN0sy1o
VITE_USER_POOL_CLIENT_ID=4q3f3mhlf5fh7jehth00pekmt4

# HTTP API base URL (from cdk deploy outputs — e.g. https://abc123.execute-api.us-east-1.amazonaws.com)
VITE_API_BASE_URL=https://te3ah5tsf9.execute-api.us-east-1.amazonaws.com
